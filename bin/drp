@cli.command('validate-epochs', short_help='Validates calibration epochs file', context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, help='an MJD to reduce')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to reduce')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to reduce')
@click.option('-c', '--calibration', type=click.Choice(CALIBRATION_TYPES), default=None, help='a calibration type')
@click.option('--epochs-path', type=str, default=CALIBRATION_EPOCHS_PATH, help='a path to a calibration epochs YAML file')
@click.option('--ring', type=click.Choice(["primary", "secondary", "both"]), default="primary", help='calibration types with exposed fibers, select the standard fibers ring')
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
def validate_epochs(mjd, mjd_list, mjd_range, calibration, epochs_path, ring):
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if not isinstance(mjds, (list, tuple)):
        mjds = [mjds]

    calibrations = CALIBRATION_TYPES if calibration is None else [calibration]

    for mjd in mjds:
        for calibration in calibrations:
            validate_calibration_epochs(mjd, calibration, epochs_path, ring)


@cli.command('detrend', short_help='Run detrending of calibrations', context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, help='an MJD to reduce')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to reduce')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to reduce')
@click.option('-c', '--calibration', type=click.Choice(CALIBRATION_TYPES), default=None, help='a calibration type')
@click.option('-s', '--skip-done', is_flag=True, default=False, help='flag to skip reduction steps that have already been done')
@click.option("--dry-run", is_flag=True, default=False, help="Shows useful information about the current setup without actually running reductions")
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
def detrend(mjd, mjd_list, mjd_range, calibration, dry_run, skip_done):
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if not isinstance(mjds, (list, tuple)):
        mjds = [mjds]

    calibrations = CALIBRATION_TYPES if calibration is None else [calibration]

    for mjd in mjds:
        for calibration in calibrations:
            detrend_calibrations(mjd, calibration, dry_run, skip_done)


@cli.command('long-term', short_help='Run long-term calibrations', context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, help='an MJD to reduce')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to reduce')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to reduce')
@click.option('--from-epochs', is_flag=True, default=False, help="Use fiducial or given epochs file to produce long-term calibrations")
@click.option('--epochs-file', type=str, default=None, help="Path to a calibrations epoch file")
@click.option('--skip-sequence-selection', is_flag=True, default=False, help='skip selection of calibration sequence, select all matching flavor instead')
@click.option('--skip-combination', is_flag=True, default=False, help='skip combining calibrations into master frame')
@click.option('-b', '--skip-bias', is_flag=True, default=False, help='skip bias calibrations')
@click.option('-t', '--skip-trace', is_flag=True, default=False, help='skip fiber traces')
@click.option('-w', '--skip-wavelength', is_flag=True, default=False, help='skip wavelength calibrations')
@click.option('--with-dome/--skip-dome', default=False, help='produce dome fiberflats, only needed for testing; science reductions use the twilight fiberflats')
@click.option('-f', '--skip-twilight', is_flag=True, default=False, help='skip twilight fiberflats')
@click.option('--cent-ncolumns', type=int, default=140, help='number of columns to trace fiber centroids')
@click.option('--full-ncolumns', type=int, default=40, help='number of columns to full fiber tracing')
@click.option('-s', '--skip-done', is_flag=True, default=False, help='flag to skip reduction steps that have already been done')
@click.option('--remeasure-arcs', is_flag=True, default=False, help='measure the arc lines again, refit the wavelength/LSF solutions and rectify the arcs again even with --skip-done; detrended and extracted arcs are reused')
@click.option("--dry-run", is_flag=True, default=False, help="Shows useful information about the current setup without actually running reductions")
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
def longterm(mjd, mjd_list, mjd_range, from_epochs, epochs_file,
             skip_sequence_selection, skip_combination,
             skip_bias, skip_trace, skip_wavelength,
             with_dome, skip_twilight,
             cent_ncolumns, full_ncolumns,
             skip_done, remeasure_arcs, dry_run):
    """ Run calibration sequence reduction """

    only_cals = {flavor for flavor, skip in zip(["bias", "trace", "wave", "dome", "twilight"],
                                                [skip_bias, skip_trace, skip_wavelength, not with_dome, skip_twilight]) if not skip}

    # parse calibration MJDs
    epochs = {}
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if mjds is not None and not isinstance(mjds, (list, tuple)):
        mjds = [mjds]
    # if no MJD, get fiducial calibration epochs
    if from_epochs or mjds is None:
        epochs = load_epochs_file(epochs_kind="calibration", epochs_path=epochs_file, filter_by_mjds=mjds)
        mjds = sorted(list(epochs.keys()))

    # run reduction sequence
    for mjd in mjds:
        reduce_longterm_sequence(
            mjd=mjd, epochs=epochs,
            only_cals=only_cals,
            cent_guess_ncolumns=cent_ncolumns, trace_full_ncolumns=full_ncolumns,
            skip_sequence_selection=skip_sequence_selection,
            skip_combination=skip_combination,
            skip_done=skip_done,
            remeasure_arcs=remeasure_arcs,
            dry_run=dry_run)


@cli.command('nightly', short_help='Run nightly calibrations', context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, help='an MJD to reduce')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to reduce')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to reduce')
@click.option('-b', '--skip-bias', is_flag=True, default=False, help='skip bias calibrations')
@click.option('-t', '--skip-trace', is_flag=True, default=False, help='skip fiber traces')
@click.option('-w', '--skip-wavelength', is_flag=True, default=False, help='skip wavelength calibrations')
@click.option('-d', '--skip-dome', is_flag=True, default=False, help='skip dome fiberflats')
@click.option('--cent-ncolumns', type=int, default=140, help='number of columns to trace fiber centroids')
@click.option('--full-ncolumns', type=int, default=40, help='number of columns to full fiber tracing')
@click.option('-s', '--skip-done', is_flag=True, default=False, help='flag to skip reduction steps that have already been done')
@click.option('--remeasure-arcs', is_flag=True, default=False, help='measure the arc lines again, refit the wavelength/LSF solutions and rectify the arcs again even with --skip-done; detrended and extracted arcs are reused')
@click.option("--dry-run", is_flag=True, default=False, help="Shows useful information about the current setup without actually running reductions")
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
def nightly(mjd, mjd_list, mjd_range,
            skip_bias, skip_trace, skip_wavelength, skip_dome,
            cent_ncolumns, full_ncolumns,
            skip_done, remeasure_arcs, dry_run):
    """ Run nightly calibration sequence reduction, to track the instrument and the long-term calibrations """

    only_cals = {flavor for flavor, skip in zip(["bias", "trace", "wave", "dome"],
                                                [skip_bias, skip_trace, skip_wavelength, skip_dome]) if not skip}

    # parse MJDs
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if not isinstance(mjds, (list, tuple)):
        mjds = [mjds]

    # run reduction sequence
    for mjd in mjds:
        reduce_nightly_sequence(
            mjd=mjd,
            only_cals=only_cals,
            cent_guess_ncolumns=cent_ncolumns, trace_full_ncolumns=full_ncolumns,
            skip_done=skip_done, remeasure_arcs=remeasure_arcs,
            dry_run=dry_run)


@cli.command('fiberflat-corrections', short_help='Run fiberflat skyline correction using science frames', context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, help='an MJD for which fiberflats will be corrected')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to reduce')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to reduce')
@click.option('--channels', type=str, default="brz", help="Spectrograph channels that will be analysed")
@click.option('--calibration-epochs-file', type=str, default=None, help='Path to a calibrations epoch file')
@click.option('--ffactor-epochs-file', type=str, default=None, help="Path to a fiber flat factors epoch file")
@click.option('--undo-correction', is_flag=True, default=False, help='flag to undo correction if already applied')
@click.option('-s', '--skip-done', is_flag=True, default=False, help='flag to skip reduction steps that have already been done')
@click.option("--dry-run", is_flag=True, default=False, help="Shows useful information about the current setup without actually running reductions")
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
def fiberflat_corrections(mjd, mjd_list, mjd_range, channels, calibration_epochs_file, ffactor_epochs_file,
                          undo_correction, skip_done, dry_run):

    # parse MJDs
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if mjds is None:
        raise click.UsageError("One of --mjd, --mjd-list, or --mjd-range is required.")

    if not isinstance(mjds, (list, tuple)):
        mjds = [mjds]
    mjds = [int(mjd) for mjd in mjds]

    # require either both epoch files or sience-mjds/expnums or twilight-mjds/expnums
    calibration_epochs = load_epochs_file(epochs_kind="calibration", epochs_path=calibration_epochs_file, verbose=False)
    ffactor_epochs = load_epochs_file(epochs_kind="ffactor", epochs_path=ffactor_epochs_file, verbose=False)

    # filter mjds for factors epoch
    _mjds = [mjd for mjd in mjds if mjd in ffactor_epochs]
    if not _mjds:
        raise ValueError(f"Invalid values in `mjds`: {mjds}. Expected values in {list(ffactor_epochs.keys())}")

    for mjd in _mjds:
        for channel in channels:
            create_fiberflats_corrections(mjd=mjd, channel=channel, ffactor_epochs=ffactor_epochs, calibration_epochs=calibration_epochs,
                                          skip_done=skip_done, undo_correction=undo_correction, display_plots=False, dry_run=dry_run)


@cli.command('ffactors-experiment', short_help='Run a fiber flat-field factor experiment with given parameters', context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, help='an MJD to reduce')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to reduce')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to reduce')
@click.option('--drpver', type=str, help='Version of the science frame reductions to use for factor measurements')
@click.option('--channel', type=click.Choice("brz"), default="b", help='channel for which factors will be measured')
@click.option('--b-skyline', type=float, default=SKYLINES_FIBERFLAT["b"], help='sky line in b-channel')
@click.option('--r-skyline', type=float, default=SKYLINES_FIBERFLAT["r"], help='sky line in r-channel')
@click.option('--z-skyline', type=float, default=SKYLINES_FIBERFLAT["z"], help='sky line in z-channel')
@click.option('--dwave', type=float, default=20.0, help='width of the wavelength window around the sky line in Angstroms')
@click.option('--fiber-radius', type=float, default=0.01, help='fiber radius in pixels')
@click.option('--oversampling-factor', type=int, default=100, help='oversampling factor used when fitting the sky line')
@click.option('--quantiles', type=click.Tuple([float, float]), nargs=2, default=(5.0, 97.0), help='quantiles used to reject contaminated fibers')
@click.option('--groupby', type=click.Choice(["spec", "quad"]), default="spec", help='type of fiber grouping to use')
@click.option('--coadd-method', type=click.Choice(["fit", "average", "integrate"]), default="fit", help='type of pixel coadding performed around the sky line')
@click.option('--norm-stat', type=click.Choice(["biweight", "mean", "median"]), default="biweight", help='type of normalization to calculate the factors')
@click.option('--fit-gradient', is_flag=True, default=False, help='flag to allow for IFU gradient fitting')
@click.option('--label', type=str, help='label for the output tables')
@click.option('--table-dir', type=str, help='directory path where the output tables will be stored')
@click.option('--overwrite', is_flag=True, default=False, help='overwrite existing output tables')
@click.option('--use-untagged-cals', is_flag=True, default=False, help='use fiber flat field from the untagged (not sandbox) directory')
@click.option('--version-cals', type=str, help='fiber flat field version to use if --use-untagged-cals is given')
@click.option("--dry-run", is_flag=True, default=False, help="shows useful information about the current setup without actually running experiment")
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
def ffactors_experiment(mjd, mjd_list, mjd_range, drpver, channel, b_skyline, r_skyline, z_skyline, dwave,
                        fiber_radius, oversampling_factor, quantiles, groupby, coadd_method, norm_stat,
                        fit_gradient, label, table_dir, overwrite, use_untagged_cals, version_cals, dry_run):

    if use_untagged_cals and version_cals is None:
        raise click.UsageError(
            "--version-cals is required when --use-untagged-cals is used"
        )

    STATS = {
        "mean": bn.nanmean,
        "median": bn.nanmedian,
        "biweight": lambda x: biweight_location(x, ignore_nan=True)
    }

    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if mjds is None:
        root = pathlib.Path(os.environ["LVM_SPECTRO_REDUX"]) / drpver
        mjds = set(p.parts[-3] for p in root.glob("*XX/*/*/ancillary/lvm-wobject-?-????????.fits"))
    if mjds is not None and not isinstance(mjds, (list, tuple, set)):
        mjds = [mjds]

    sky_lines = {"b": b_skyline, "r": r_skyline, "z": z_skyline}
    for mjd in mjds:
        measure_fiberflat_factors(int(mjd), drpver=drpver, channel=channel, sky_cwaves=sky_lines, dwave=dwave,
                                  fiber_radius=fiber_radius, oversampling_factor=oversampling_factor,
                                  quantiles=quantiles, groupby=groupby, coadd_method=coadd_method,
                                  norm_stat=STATS[norm_stat], fit_gradient=fit_gradient, label=label,
                                  write_table=True, table_dir=table_dir, overwrite=overwrite,
                                  use_untagged_cals=use_untagged_cals, version_cals=version_cals,
                                  dry_run=dry_run)


@cli.command('fiberflats', short_help='Run twilight or dome fiberflat reductions', context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, help='an MJD to reduce')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to reduce')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to reduce')
@click.option('-k', '--kind', type=click.Choice(["twilight", "dome"]), default="twilight", help='Kind of fiber flats to reduce')
@click.option('--epochs-file', type=str, default=None, help="Path to a calibrations epoch file")
@click.option('--channels', type=str, default="brz", help="Spectrograph channels that will be analysed")
@click.option('--skip-sequence-selection', is_flag=True, default=False, help='skip selection of calibration sequence, select all matching flavor instead')
@click.option('--skip-combination', is_flag=True, default=False, help='skip combining calibrations into master frame')
@click.option('-s', '--skip-done', is_flag=True, default=False, help='flag to skip reduction steps that have already been done')
@click.option("--dry-run", is_flag=True, default=False, help="Shows useful information about the current setup without actually running reductions")
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
def fiberflats(mjd, mjd_list, mjd_range, kind, epochs_file, channels, skip_sequence_selection, skip_combination, skip_done, dry_run):

    # parse MJDs
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if mjds is None:
        raise click.UsageError("One of --mjd, --mjd-list, or --mjd-range is required.")

    if not isinstance(mjds, (list, tuple)):
        mjds = [mjds]
    mjds = [int(mjd) for mjd in mjds]

    epochs = load_epochs_file(epochs_kind="calibration", epochs_path=epochs_file, verbose=False)
    mjd_epochs = sorted(list(epochs.keys())) + [99999]

    cals_mjd = {mjd: mjd_epochs[i] for mjd in mjds for i in range(len(mjd_epochs) - 1) if mjd >= mjd_epochs[i] and mjd < mjd_epochs[i+1]}

    # run reduction sequence
    create_fiberflats = create_twilight_fiberflats if kind == "twilight" else create_dome_fiberflats
    for mjd in mjds:
        create_fiberflats(
            mjd=mjd,
            cals_mjd=cals_mjd[mjd],
            channels=channels,
            skip_sequence_selection=skip_sequence_selection,
            skip_combination=skip_combination,
            skip_done=skip_done,
            dry_run=dry_run)


@cli.command('pixelflats', short_help='Run pixelflats reductions', context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, help='an MJD to reduce')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to reduce')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to reduce')
@click.option('--epochs-file', type=str, default=None, help="Path to a calibrations epoch file")
@click.option('--cameras', type=StrListType(), default=",".join(CAMERAS), help="Spectrograph camera that will be analysed")
@click.option('--smoothing-box', type=int, default=31, help="Size in pixels of the median-smoothing box used to remove background")
@click.option('--min-flatfield', type=float, default=0.0, help="Minimum valid flat field value, values below will be set to 1.0")
@click.option('-s', '--skip-done', is_flag=True, default=False, help='flag to skip reduction steps that have already been done')
@click.option("--dry-run", is_flag=True, default=False, help="Shows useful information about the current setup without actually running reductions")
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
def pixelflats(mjd, mjd_list, mjd_range, epochs_file, cameras, smoothing_box, min_flatfield, skip_done, dry_run):

    # parse MJDs
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if mjds is not None and not isinstance(mjds, (list, tuple)):
        mjds = [mjds]

    # use these mjds to filter pixelflats epochs
    pixflat_epochs = load_pixflat_epochs(epochs_path=epochs_file, filter_by_mjds=mjds, filter_by_cameras=cameras)

    # throw error if filtered epochs are empty
    if not pixflat_epochs:
        available = list(load_pixflat_epochs(epochs_path=epochs_file, verbose=False))
        raise ValueError(f"Invalid values in `mjds`: {mjds}. Expected values in {available}")

    for mjd_epoch, pixflat_epoch in pixflat_epochs.items():
        mjds = pixflat_epoch.get("sources")
        sequences = pixflat_epoch.get("sequences", {})
        for camera, sequence in sequences.items():
            create_pixflats(
                mjds=mjds,
                mjd_epoch=mjd_epoch,
                camera=camera,
                sequence=sequence,
                size=smoothing_box,
                min_flatfield=min_flatfield,
                skip_done=skip_done,
                dry_run=dry_run)


@cli.command('super-pixelflats', short_help='Run pixelflats reductions combining all epochs into a super pixel flat field', context_settings=dict(show_default=True))
@click.option('--mjd-epoch', type=int, required=True, help='MJD of the super pixel flat fields epoch')
@click.option('-m', '--mjd', type=int, help='an MJD to reduce')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to reduce')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to reduce')
@click.option('--epochs-file', type=str, default=None, help="Path to a calibrations epoch file")
@click.option('--cameras', type=StrListType(), default=",".join(CAMERAS), help="Spectrograph camera that will be analysed")
@click.option('--smoothing-box', type=int, default=31, help="Size in pixels of the median-smoothing box used to remove background")
@click.option('--min-flatfield', type=float, default=0.0, help="Minimum valid flat field value, values below will be set to 1.0")
@click.option('-s', '--skip-done', is_flag=True, default=False, help='flag to skip reduction steps that have already been done')
@click.option("--dry-run", is_flag=True, default=False, help="Shows useful information about the current setup without actually running reductions")
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
def super_pixelflats(mjd_epoch, mjd, mjd_list, mjd_range, epochs_file, cameras, smoothing_box, min_flatfield, skip_done, dry_run):

    # parse MJDs
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if mjds is not None and not isinstance(mjds, (list, tuple)):
        mjds = [mjds]

    # use these mjds to filter pixelflats epochs
    pixflat_epochs = load_pixflat_epochs(epochs_path=epochs_file, filter_by_mjds=mjds, filter_by_cameras=cameras)

    # throw error if filtered epochs are empty
    if not pixflat_epochs:
        available = list(load_pixflat_epochs(epochs_path=epochs_file, verbose=False))
        raise ValueError(f"Invalid values in `mjds`: {mjds}. Expected values in {available}")

    create_super_pixflats(
        pixflat_epochs=pixflat_epochs,
        mjd_epoch=mjd_epoch,
        size=smoothing_box,
        min_flatfield=min_flatfield,
        skip_done=skip_done,
        dry_run=dry_run)


@click.command('create-tag', short_help='Create a tag for long-term calibrations', context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, help='an MJD to reduce')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to reduce')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to reduce')
@click.option('--from-epochs', is_flag=True, default=False, help="Use fiducial or given epochs file to produce long-term calibrations")
@click.option('--epochs-file', type=str, default=None, help="Path to a calibrations epoch file")
@click.option('--version', type=str, default=drpver, help='Version of the calibration set')
@click.option("--dry-run", is_flag=True, default=False, help="Shows useful information about the current setup without actually running reductions")
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
def create_longterm_tag(mjd, mjd_list, mjd_range, from_epochs, epochs_file, version, dry_run):

    # parse calibration MJDs
    epochs = {}
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if mjds is not None and not isinstance(mjds, (list, tuple)):
        mjds = [mjds]
    # if no MJD, get fiducial calibration epochs
    if from_epochs or mjds is None:
        epochs = load_epochs_file(epochs_kind="calibration", epochs_path=epochs_file, filter_by_mjds=mjds, verbose=False)
        mjds = sorted(list(epochs.keys()))

    for mjd in mjds:
        flavors = []
        [flavors.extend(CALIBRATION_MAPPINGS.get(calname, [calname])) for calname in CALIBRATION_TYPES]
        tag_longterm_calibrations(mjd=mjd, version=version, flavors=flavors, dry_run=dry_run)


@cli.command('tag-pixelflats', short_help='Tag pixel flats for a pipeline version', context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, required=True, help='Pixel-flat epoch MJD to tag')
@click.option('--version', type=str, default=drpver, help='Version of the calibration set')
@click.option("--dry-run", is_flag=True, default=False, help="Show source and destination paths without copying files")
def create_pixelflats_tag(mjd, version, dry_run):
    """Copy the single pixel-flat epoch into the sandbox calibration directory."""
    tag_pixelflats(epoch_mjd=mjd, version=version, dry_run=dry_run)


def _parse_artifact_bins(ctx, param, value):
    try:
        return tuple(tuple(int(edge) for edge in pair.split('-')) for pair in value.split(','))
    except ValueError:
        raise click.BadParameter(f"expected comma-separated 'min-max' pairs, got {value!r}")


@cli.command('qa-raw-pixelflats', short_help='Run the QA of the raw pixel-flat sequences of an epoch', context_settings=dict(show_default=True))
@click.option('-m', '--mjd-epoch', type=int, required=True, help='MJD of the pixel-flat epoch, as in the epochs file')
@click.option('--cameras', type=StrListType(), default=",".join(CAMERAS), help="Spectrograph cameras to check")
@click.option('--epochs-file', type=str, default=None, help="Path to a pixel-flat epochs file")
@click.option('-o', '--output-dir', type=str, default=None, help="Directory of the dashboard and measurements table. Defaults to a pixflat_qa directory in the epoch's ancillary directory")
@click.option('-n', '--nprocs', type=int, default=1, help="Number of processes measuring the raw frames")
@click.option('--cut-rows', type=IntListType(), default="1020,3060", help="Rows of the illumination cuts along X")
@click.option('--cut-columns', type=IntListType(), default="1021,3098", help="Columns of the illumination cuts along Y")
@click.option('--cut-width', type=int, default=21, help="Width in pixels of the band collapsed into each cut")
@click.option('--combined', is_flag=True, default=False, help="Make the illumination cuts on the average of all the flats instead of the first one")
@click.option('--image-binning', type=int, default=16, help="Binning factor of the raw image shown next to the cuts")
@click.option('--n-contrast', type=int, default=5, help="Number of contrast measurements per cut, from the CCD center towards the edge")
@click.option('--contrast-window', type=int, default=51, help="Width in pixels of each contrast window")
@click.option('--saturation', type=float, default=65000.0, help="Raw count level (ADU) at and above which a pixel counts as saturated")
@click.option('--target-precision', type=float, default=0.002, help="Poisson-limited precision the accumulated flats should reach")
@click.option('--max-level-deviation', type=float, default=0.02, help="Largest deviation of a flat's level from the sequence median before it is flagged")
@click.option('--max-saturated', type=float, default=1e-4, help="Largest fraction of saturated pixels in a flat quadrant before it is flagged")
@click.option('--max-dark-signal', type=float, default=20.0, help="Largest signal in a dark (e-/pixel above the overscan) before it is flagged")
@click.option('--remeasure', is_flag=True, default=False, help="Measure all the raw frames again instead of reusing the measurements table")
@click.option("--dry-run", is_flag=True, default=False, help="Show the sequences, raw files found and output paths without measuring anything")
def qa_raw_pixelflats_cli(mjd_epoch, cameras, epochs_file, output_dir, nprocs, cut_rows, cut_columns, cut_width, combined,
                          image_binning, n_contrast, contrast_window, saturation, target_precision, max_level_deviation,
                          max_saturated, max_dark_signal, remeasure, dry_run):
    """Check the raw pixel-flat sequences of an epoch and write an HTML dashboard."""
    epochs = load_pixflat_epochs(epochs_path=epochs_file, verbose=False) if epochs_file else None
    qa_raw_pixelflats(mjd_epoch=mjd_epoch, cameras=cameras, epochs=epochs, output_dir=output_dir, nprocs=nprocs,
                      cut_rows=cut_rows, cut_columns=cut_columns, cut_width=cut_width, combined=combined,
                      image_binning=image_binning, n_contrast=n_contrast, contrast_window=contrast_window,
                      saturation=saturation, target_precision=target_precision, max_level_deviation=max_level_deviation,
                      max_saturated=max_saturated, max_dark_signal=max_dark_signal, skip_done=not remeasure, dry_run=dry_run)


def _max_four_fibers(ctx, param, value):
    if value is not None and len(value) > 4:
        raise click.BadParameter(f"at most 4 fibers, got {len(value)}")
    return value


