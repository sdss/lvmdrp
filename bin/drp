                        extract=extract, nprocs=nprocs, skip_done=not remeasure, dry_run=dry_run)


def _at_most_two_versions(ctx, param, value):
    if value is not None and len(value) > 2:
        raise click.BadParameter(f"at most 2 versions, got {len(value)}")
    return value


