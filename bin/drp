@cloup.command('qa-pixelflats', short_help='Run the QA of the pixel flats of an epoch against a reference epoch', show_constraints=True, context_settings=dict(show_default=True))
@click.option('-t', '--mjd-tar', type=int, required=True, help='MJD of the target pixel-flat epoch, the one being checked')
@click.option('-r', '--mjd-ref', type=int, required=True, help='MJD of the reference pixel-flat epoch, the one to compare against')
@click.option('--cameras', type=StrListType(), default=",".join(CAMERAS), help="Spectrograph cameras to check")
@click.option('--parts', type=StrListType(), default=",".join(QA_PARTS), help=f"Parts of the QA to run, any of {','.join(QA_PARTS)}")
@click.option('--test-mjd', type=int, default=None, help='MJD of the exposure used for the flat-fielded comparison')
@click.option('--test-expnum', type=int, default=None, help='Exposure number used for the flat-fielded comparison. If omitted, the comparison is skipped')
@click.option('--epochs-file', type=str, default=None, help="Path to a pixel-flat epochs file")
@click.option('-o', '--output-dir', type=str, default=None, help="Directory of the dashboard. Defaults to a pixflat_qa directory in the target epoch's ancillary directory")
@click.option('--bins', type=str, default=",".join(f"{lo}-{hi}" for lo, hi in ARTIFACT_BINS), callback=_parse_artifact_bins, help="Region-size bins used to group artifacts, as comma-separated 'min-max' pairs")
@click.option('--bbox-size', type=int, default=30, help="Width of each artifact cutout in pixels")
@click.option('--max-regions', type=int, default=10, help="Maximum number of artifact regions shown per size bin")
@click.option('--min-consistency', type=float, default=99.0, help="Lowest percentage of pixels within 1%% of the reference before a camera is flagged")
@click.option('-s', '--skip-done', is_flag=True, default=False, help='flag to reuse existing test-frame reductions')
@click.option("--dry-run", is_flag=True, default=False, help="Show the cameras, test-frame paths and dashboard path without running any check")
@cloup.constraint(cloup.constraints.all_or_none, ['test_mjd', 'test_expnum'])
def qa_pixelflats_cli(mjd_tar, mjd_ref, cameras, parts, test_mjd, test_expnum, epochs_file, output_dir,
                      bins, bbox_size, max_regions, min_consistency, skip_done, dry_run):
    """Compare the pixel flats of a target epoch against a reference epoch and write an HTML dashboard."""
    unknown = set(parts).difference(QA_PARTS)
    if unknown:
        raise click.BadParameter(f"unknown parts {sorted(unknown)}, expected any of {', '.join(QA_PARTS)}", param_hint="--parts")
    test_frames = None
    if test_expnum is not None:
        test_frames = get_frames_metadata(mjd=test_mjd, suffix="fits.gz", overwrite=False).query("expnum == @test_expnum")
        if test_frames.empty:
            raise click.BadParameter(f"exposure {test_expnum} not found in MJD {test_mjd}", param_hint="--test-expnum")

    epochs = load_pixflat_epochs(epochs_path=epochs_file, verbose=False) if epochs_file else None

    qa_pixelflats(mjd_tar=mjd_tar, mjd_ref=mjd_ref, skip_done=skip_done, dry_run=dry_run, cameras=cameras, parts=parts,
                  test_frames=test_frames, epochs=epochs, output_dir=output_dir,
                  bins=bins, bbox_size=bbox_size, max_regions=max_regions, min_consistency=min_consistency)


def _parse_mjd_range(value):
    """Parse an 'MJD1-MJD2' range into an inclusive (min, max) tuple."""
    try:
        start, end = map(int, value.split("-"))
    except ValueError:
        raise click.BadParameter(f"expected 'MJD1-MJD2', got {value!r}", param_hint="--mjd-range")
    return min(start, end), max(start, end)


@cloup.command('qa-flatfield', short_help='Run the flat-field QA on flat-fielded science frames and write an HTML report', show_constraints=True, context_settings=dict(show_default=True))
@click.option('-d', '--drpver', type=str, default=drpver, help='Pipeline version (tag) whose lvmFrame files are checked')
@click.option('--redux-dir', type=str, default=None, help='Reductions root directory. Defaults to $LVM_SPECTRO_REDUX')
@click.option('-m', '--mjd', type=int, help='an MJD to check')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to check')
@click.option('-r', '--mjd-range', type=str, help="a range of MJDs to check, as 'MJD1-MJD2'")
@click.option('-t', '--tileid-list', type=IntListType(), default=None, help='a list of tile IDs to check')
@click.option('-F', '--frames-file', type=click.Path(exists=True, dir_okay=False), default=None, help='a text file with one lvmFrame path per line, instead of searching the reductions')
@click.option('-c', '--channels', type=str, default="brz", help='Channels to check')
@click.option('-o', '--output-dir', type=str, default=None, help='Directory of the report and summary table. Defaults to qa/flatfield/{selection} in the reductions of --drpver, e.g. qa/flatfield/mjd_60300-61330')
@click.option('--label', type=str, default="flatfield_qa", help='Name of the summary table and report')
@click.option('--title', type=str, default="LVM Flat-Field QA", help='Title of the HTML report')
@click.option('-n', '--nprocs', type=int, default=1, help='Number of processes measuring frames')
@click.option('--min-exptime', type=float, default=0.0, help='Frames with shorter exposure times (seconds) are skipped')
@click.option('--telescopes', type=StrListType(), default=",".join(QA_TELESCOPES), help='Telescopes whose fibers are measured')
@click.option('--line-method', type=click.Choice(["fit", "integrate"]), default="fit", help='Sky line measurement: Gaussian plus continuum floor fit, or sideband-subtracted window sum')
@click.option('--gradient-deg', type=click.Choice(["0", "1", "2", "none"]), default="1", help='Degree of the sky gradient fitted across each IFU with the spectrograph offsets (0: offsets only, none: no correction)')
@click.option('--min-snr', type=float, default=10.0, help='Minimum median S/N of a reliable feature')
@click.option('--min-good-fraction', type=float, default=0.8, help='Minimum fraction of good line fits of a reliable sky line')
@click.option('--min-contrast', type=float, default=1.0, help='Minimum median line peak over continuum of a reliable sky line')
@click.option('--max-deviation', type=float, default=0.02, help='Deviation from 1 of a normalized flux counted as an outlier fiber')
@click.option('--checkpoint-every', type=int, default=200, help='Number of frames after which the summary table is written')
@click.option('--frame-plots', is_flag=True, default=False, help='Also save the QA plot of each frame')
@click.option('--overwrite', is_flag=True, default=False, help='Measure all frames again instead of resuming from an existing summary table')
@click.option('--report-only', is_flag=True, default=False, help='Only regenerate the HTML report from an existing summary table')
@click.option('--dry-run', is_flag=True, default=False, help='Show the frames found and the output paths without measuring anything')
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(mutually_exclusive, ['frames_file', 'mjd'])
@cloup.constraint(mutually_exclusive, ['frames_file', 'mjd_list'])
@cloup.constraint(mutually_exclusive, ['frames_file', 'mjd_range'])
def qa_flatfield_cli(drpver, redux_dir, mjd, mjd_list, mjd_range, tileid_list, frames_file, channels, output_dir, label, title,
                     nprocs, min_exptime, telescopes, line_method, gradient_deg, min_snr, min_good_fraction, min_contrast,
                     max_deviation, checkpoint_every, frame_plots, overwrite, report_only, dry_run):
    """Measure sky lines and continuum windows in lvmFrame files, and write an HTML report of the flat-field quality across wavelength and time.

    Runs can be resumed: frames already in the summary table are skipped unless --overwrite is given.
    """
    mjds = [mjd] if mjd is not None else (mjd_list or None)
    mjd_range = _parse_mjd_range(mjd_range) if mjd_range else None
    if output_dir is None:
        name = flatfield_qa_name(mjds=mjds, mjd_range=mjd_range, tileids=tileid_list, frames_file=frames_file)
        output_dir = default_flatfield_qa_dir(drpver, name, redux_dir=redux_dir)
    table_path = os.path.join(output_dir, f"{label}.fits")
    html_path = os.path.join(output_dir, f"{label}.html")

    if report_only:
        if not os.path.isfile(table_path):
            raise click.UsageError(f"no summary table to report from: {table_path}")
        if dry_run:
            click.echo(f"would regenerate {html_path} from {table_path}")
            return
        report_flatfield_qa(table_path, out_html=html_path, title=title, run_info={"telescopes": telescopes})
        click.echo(f"report written to {html_path}")
        return

    if frames_file:
        with open(frames_file) as f:
            frame_paths = [line.strip() for line in f if line.strip() and not line.startswith("#")]
    else:
        frame_paths = find_frames(drpver, channels=channels, mjds=mjds, tileids=tileid_list, redux_dir=redux_dir,
                                  mjd_range=mjd_range)
    if not frame_paths:
        raise click.UsageError("no lvmFrame files found for the given selection")

    if dry_run:
        click.echo(f"{len(frame_paths)} lvmFrame files, e.g.:")
        for path in frame_paths[:5]:
            click.echo(f"  {path}")
        click.echo(f"summary table: {table_path}")
        click.echo(f"report: {html_path}")
        return

    run_flatfield_qa_batch(frame_paths, out_dir=output_dir, label=label, nprocs=nprocs, frame_plots=frame_plots,
                           min_exptime=min_exptime, overwrite=overwrite, checkpoint_every=checkpoint_every, report_title=title,
                           telescopes=tuple(telescopes), line_method=line_method,
                           gradient_deg=None if gradient_deg == "none" else int(gradient_deg),
                           min_snr=min_snr, min_good_fraction=min_good_fraction, min_contrast=min_contrast,
                           max_deviation=max_deviation)
    click.echo(f"report written to {html_path}")


@cloup.command('qa-twilights', short_help='Check the gradient removed from a twilight sequence against the sky geometry', show_constraints=True, context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, help='an MJD of twilight exposures')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of MJDs of twilight exposures')
@click.option('-r', '--mjd-range', type=str, help="a range of MJDs of twilight exposures, as 'MJD1-MJD2'")
@click.option('-c', '--channels', type=str, default="brz", help='Channels to check')
@click.option('-d', '--drpver', type=str, default=drpver, help='Pipeline version of the per-exposure twilight flats')
@click.option('--no-raw', is_flag=True, default=False, help='Leave out the twilight exposures without a per-exposure flat, instead of showing their sky geometry from the raw headers')
@click.option('-t', '--trends', is_flag=True, default=False, help='Write a summary of the gradient over all the nights instead of the per-exposure dashboard: gradient strength and direction versus time, Sun, Moon, pointing and lab conditions')
@click.option('-k', '--kmirror', type=str, default=None, help="Infer the position angle from the K-mirror angle (TESCIKM) when POSCIPA is missing: a drpall file (FITS or .h5) to calibrate the relation on guider-solved frames, or a kmirror_pa.json saved by a previous run")
@click.option('-o', '--output-dir', type=str, default=None, help="Directory of the dashboard and table. Defaults to fiberflat_qa/twilights_{mjds} in the ancillary directory of the first MJD")
@click.option('--dry-run', is_flag=True, default=False, help='Show the per-exposure flats found and the output paths without reading them')
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
def qa_twilights_cli(mjd, mjd_list, mjd_range, channels, drpver, no_raw, trends, kmirror, output_dir, dry_run):
    """Compare the gradient and spectrograph factors removed from each twilight exposure with its sky geometry and write an HTML dashboard.

    Uses the per-exposure flats of the twilight fiber flat procedure; make them with
    'drp calibrations fiberflats --skip-combination'.
    """
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    mjds = [int(m) for m in (mjds if isinstance(mjds, (list, tuple)) else [mjds])]
    try:
        if trends:
            result = qa_twilight_trends(mjds, channels=channels, drpver=drpver, kmirror=kmirror, output_dir=output_dir, dry_run=dry_run)
        else:
            result = qa_twilight_sequence(mjds, channels=channels, drpver=drpver, include_raw=not no_raw,
                                          kmirror=kmirror, output_dir=output_dir, dry_run=dry_run)
    except (FileNotFoundError, ValueError) as e:
        raise click.UsageError(str(e))
    if result["report"]:
        click.echo(f"dashboard written to {result['report']}")


@cloup.command('qa-domes', short_help='Check the gradient removed from a dome flat sequence against the pointing geometry', show_constraints=True, context_settings=dict(show_default=True))
@click.option('-e', '--epoch', type=int, help="a calibration epoch MJD; uses its 'dome' MJDs from the epochs file")
@click.option('-m', '--mjd', type=int, help='an MJD of dome flat exposures')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of MJDs of dome flat exposures')
@click.option('-r', '--mjd-range', type=str, help="a range of MJDs of dome flat exposures, as 'MJD1-MJD2'")
@click.option('--epochs-file', type=str, default=None, help='Path to a calibrations epoch file. Defaults to the one in lvmcore')
@click.option('-c', '--channels', type=str, default="brz", help='Channels to check')
@click.option('-d', '--drpver', type=str, default=drpver, help='Pipeline version of the per-exposure dome flats')
@click.option('--no-raw', is_flag=True, default=False, help='Leave out the dome flat exposures without a per-exposure flat, instead of showing their geometry from the raw headers')
@click.option('-t', '--trends', is_flag=True, default=False, help='Write a summary of the gradient over all the nights instead of the per-exposure dashboard: gradient strength and direction versus time, pointing, Sun, Moon and lab conditions')
@click.option('-k', '--kmirror', type=str, default=None, help="Infer the position angle from the K-mirror angle (TESCIKM) when POSCIPA is missing: a drpall file (FITS or .h5) to calibrate the relation on guider-solved frames, or a kmirror_pa.json saved by a previous run")
@click.option('-o', '--output-dir', type=str, default=None, help="Directory of the dashboard and table. Defaults to fiberflat_qa/domes_{epoch} (or dome_trends_{mjds} with --trends) in the ancillary directory of the epoch, or of the first MJD")
@click.option('--dry-run', is_flag=True, default=False, help='Show the per-exposure flats found and the output paths without reading them')
@cloup.constraint(RequireExactly(1), ['epoch', 'mjd', 'mjd_list', 'mjd_range'])
def qa_domes_cli(epoch, mjd, mjd_list, mjd_range, epochs_file, channels, drpver, no_raw, trends, kmirror, output_dir, dry_run):
    """Compare the gradient and spectrograph factors removed from each dome flat exposure with its pointing geometry and write an HTML dashboard.

    The dome version of 'qa-twilights', with the same plots. Uses the per-exposure flats of the dome
    fiber flat procedure; make them with 'drp calibrations fiberflats --kind dome --skip-combination'
    or 'drp calibrations long-term --with-dome'.
    """
    if epoch is not None:
        epochs = load_epochs_file(epochs_kind="calibration", epochs_path=epochs_file, verbose=False)
        if epoch not in epochs:
            raise click.UsageError(f"no calibration epoch {epoch} in the epochs file")
        mjds = get_epoch(mjd=epoch, epochs=epochs, epochs_kind="calibration")["dome"]
    else:
        mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    mjds = [int(m) for m in (mjds if isinstance(mjds, (list, tuple)) else [mjds])]
    try:
        if trends:
            result = qa_dome_trends(mjds, channels=channels, drpver=drpver, kmirror=kmirror, output_dir=output_dir, dry_run=dry_run)
        else:
            result = qa_dome_sequence(mjds, channels=channels, drpver=drpver, include_raw=not no_raw, kmirror=kmirror,
                                      epoch_mjd=epoch, output_dir=output_dir, dry_run=dry_run)
    except (FileNotFoundError, ValueError) as e:
        raise click.UsageError(str(e))
    if result["report"]:
        click.echo(f"dashboard written to {result['report']}")


@cloup.command('qa-instrument-gradient', short_help='Test for an instrument gradient across the science IFU, besides the sky gradient', context_settings=dict(show_default=True))
@click.option('-t', '--twilight', type=str, default=None, help="Table of the twilight trends ('qa-twilights --trends'), CSV")
@click.option('-D', '--dome', type=str, default=None, help="Table of the dome flat trends ('qa-domes --trends'), CSV")
@click.option('-s', '--science', type=str, default=None, help="Science frame gradients: the summary table of 'drp qa-flatfield' (FITS), whose lvmFrame headers give the geometry, or a CSV saved by a previous run")
@click.option('-b', '--breaks', type=IntListType(), default=None, help='MJDs where the instrument gradient may jump')
@click.option('--interventions', is_flag=True, default=False, help="Break at the calibration epochs triggered by instrument interventions and warm-ups, instead of --breaks")
@click.option('--epochs-file', type=str, default=None, help='Path to a calibration epochs file, for --interventions and to group the maps of the flats by epoch. Defaults to the one in lvmcore')
@click.option('-c', '--channels', type=str, default="brz", help='Channels to fit')
@click.option('-k', '--kmirror', type=str, default=None, help="K-mirror relation (a kmirror_pa.json or a drpall file), for the frames without POSCIPA and the sign of the field angle")
@click.option('-d', '--drpver', type=str, default=None, help='Pipeline version of the lvmFrames of --science. Defaults to the one in the summary')
@click.option('--redux-dir', type=str, default=None, help='Reductions root directory of the lvmFrames. Defaults to $LVM_SPECTRO_REDUX')
@click.option('--roses', is_flag=True, default=False, help='Add the polar histograms of the direction of g and g - I relative to the Sun, the horizon and the Moon')
@click.option('-n', '--name', type=str, default="instrument_gradient", help='Name of the dashboard and tables')
@click.option('-o', '--output-dir', type=str, default=None, help="Directory of the dashboard and tables. Defaults to qa/fiberflat/{name} in the master calibrations directory")
def qa_instrument_gradient_cli(twilight, dome, science, breaks, interventions, epochs_file, channels, kmirror, drpver, redux_dir, roses, name, output_dir):
    """Fit the gradients across the science IFU of twilights, dome flats and science frames as an instrument gradient plus a sky gradient, and write an HTML dashboard.

    Compares an instrument gradient fixed in the IFU, one fixed before the K-mirror and none, with and
    without jumps at the breaks, and checks the instrument gradient of the twilights against the dome
    flats and the science frames.
    """
    if not (twilight or dome or science):
        raise click.UsageError("give at least one of --twilight, --dome or --science")
    if interventions:
        breaks = intervention_breaks(load_calibration_epochs(epochs_file))
        click.echo(f"breaks at {', '.join(map(str, breaks))}")
    if science and science.endswith((".fits", ".fits.gz")):
        table = science_gradients(science, drpver=drpver, redux_dir=redux_dir, kmirror=kmirror)
        science = os.path.join(output_dir or os.path.dirname(os.path.abspath(science)), f"{name}_science.csv")
        os.makedirs(os.path.dirname(science), exist_ok=True)
        table.to_csv(science, index=False)
        click.echo(f"science frame gradients written to {science}")
    try:
        result = qa_instrument_gradient(twilight=twilight, dome=dome, science=science, breaks=breaks, channels=channels,
                                        kmirror=kmirror, epochs=load_calibration_epochs(epochs_file), roses=roses, output_dir=output_dir, name=name)
    except (FileNotFoundError, ValueError) as e:
        raise click.UsageError(str(e))
    click.echo(f"dashboard written to {result['report']}")


@cloup.command('qa-fiberflats', short_help='Compare the master fiber flats of all calibration epochs against a reference epoch', show_constraints=True, context_settings=dict(show_default=True))
@click.option('-r', '--mjd-ref', type=int, default=None, help='MJD of the reference calibration epoch. Defaults to the latest epoch with flats in all channels')
@click.option('-c', '--channels', type=str, default="brz", help='Channels to compare')
@click.option('-k', '--kind', type=click.Choice(["twilight", "dome"]), default="twilight", help='Kind of fiber flat')
@click.option('--epochs-file', type=str, default=None, help='Path to a calibration epochs file. Defaults to calibration-epochs.yaml in $LVMCORE_DIR/calibrations')
@click.option('--flats-dir', type=str, default=None, help='Master calibrations directory. Defaults to $LVM_MASTER_DIR')
@click.option('-d', '--drpver', type=str, default=None, help='Compare the master fiber flats of this pipeline version instead of the master calibrations directory')
@click.option('--redux-dir', type=str, default=None, help='Reductions root directory for --drpver. Defaults to $LVM_SPECTRO_REDUX')
@click.option('-o', '--output-dir', type=str, default=None, help='Directory of the dashboard and summary table. Defaults to qa/fiberflat/{kind}_vs_{mjd_ref} in the master calibrations directory, or the reference epoch ancillary directory of --drpver')
@click.option('--bin-width', type=float, default=50.0, help='Width in Angstroms of the wavelength bins the flats are compared in')
@click.option('--telescopes', type=StrListType(), default=",".join(QA_TELESCOPES), help='Telescopes whose fibers enter the ratio statistics')
@click.option('--max-deviation', type=float, default=0.01, help='Deviation of a ratio from 1 counted as off')
@click.option('--gradient-deg', type=click.IntRange(0, 2), default=1, help='Degree of the gradient across each IFU in the decomposition of the ratios')
@click.option('--dry-run', is_flag=True, default=False, help='Show the flats found and the output paths without reading flats')
@cloup.constraint(cloup.constraints.If('redux_dir', then=cloup.constraints.require_all), ['drpver'])
@cloup.constraint(mutually_exclusive, ['flats_dir', 'drpver'])
def qa_fiberflats_cli(mjd_ref, channels, kind, epochs_file, flats_dir, drpver, redux_dir, output_dir, bin_width, telescopes,
                      max_deviation, gradient_deg, dry_run):
    """Compare the master fiber flats of the calibration epochs against a reference epoch and write an HTML dashboard.

    The epochs, their triggers and comments come from the calibration epochs file.
    """
    epochs = load_calibration_epochs(epochs_file)
    try:
        result = qa_fiberflat_epochs(mjd_ref=mjd_ref, channels=channels, kind=kind, epochs=epochs, flats_dir=flats_dir,
                                     drpver=drpver, redux_dir=redux_dir, output_dir=output_dir, bin_width=bin_width,
                                     telescopes=tuple(telescopes), max_deviation=max_deviation, gradient_deg=gradient_deg,
                                     dry_run=dry_run)
    except (ValueError, FileNotFoundError) as e:
        raise click.UsageError(str(e))
    if result["report"]:
        click.echo(f"dashboard written to {result['report']}")


@cli.command('fix-pixel-shifts', short_help='Fix the electronic pixel shifts in the raw data', context_settings=dict(show_default=True))
@click.option('-m', '--mjd', type=int, help='the MJD to reduce')
@click.option('-e', '--expnums', type=IntListType(), help='a list of exposure numbers to reduce')
@click.option('-r', '--ref-expnums', type=IntListType(), help='a list of reference exposure numbers')
@click.option('--img-types', type=StrListType(), help='a list of image types to analyse')
@click.option('-s', '--specs', type=str, default='123', help='spectrographs to analyze')
@click.option('-c', '--custom-shift', type=(str, int, int), multiple=True, help='3-tuple of spectrograph, exposure and pixel row to shift from')
@click.option('-f', '--flat-spikes', type=int, default=21, help='the window within which to filter spikes')
@click.option('-t', '--threshold-spikes', type=float, default=0.6, help='the threshold for the spikes filtering')
@click.option('-i', '--interactive', is_flag=True, default=False, help='flag to run in interactive mode when QC and DRP discrepancies are found')
def detect_shifts(mjd, expnums, ref_expnums, img_types, specs, custom_shift, flat_spikes, threshold_spikes, interactive):
    """ Fix the electronic pixel shifts in the raw data """
    custom_shifts = {}
    for key, vals in groupby(custom_shift, key=lambda t: t[:2]):
        custom_shifts[key] = list(v[-1] for v in vals)

    fix_raw_pixel_shifts(mjd=mjd, expnums=expnums, ref_expnums=ref_expnums, imagetyps=img_types, specs=specs,
                         shift_rows=custom_shifts, flat_spikes=flat_spikes,
                         threshold_spikes=threshold_spikes,
                         interactive=interactive)


@click.command('calibfib-hdrfix', short_help='HdrFix for CALIBFIB header keyword in dome/twilight flats and arcs calibration')
@click.option('-m', '--mjd', type=int, help='an MJD to analyze')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to analyze')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to analyze')
@click.option('-c', '--calibration', type=click.Choice(calibration_types), default=None, help='a calibration type')
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
def calibfib_hdrfix(mjd, mjd_list, mjd_range, calibration):

    REF_COLUMNS = {"wave": 1000}
    NCOLUMNS = {"wave": 1000}

    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if not isinstance(mjds, (list, tuple)):
        mjds = [mjds]

    calibrations = calibration_types if calibration is None else [calibration]

    for mjd in mjds:
       for calibration in calibrations:
            create_calibfib_hdrfix(
                mjd=mjd,
                calibration=calibration,
                ref_column=REF_COLUMNS.get(calibration, LVM_REFERENCE_COLUMN),
                ncolumns=NCOLUMNS.get(calibration, 1000))


@click.command('imagetyp-hdrfix', short_help='HdrFix for IMAGETYP header keyword in dome/twilight flats and arcs calibration')
@click.option('-m', '--mjd', type=int, help='an MJD to analyze')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to analyze')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to analyze')
@click.option('-c', '--calibration', type=click.Choice(CALIBRATION_TYPES), default=None, help='a calibration type')
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
def imagetyp_hdrfix(mjd, mjd_list, mjd_range, calibration):
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if not isinstance(mjds, (list, tuple)):
        mjds = [mjds]

    calibrations = CALIBRATION_TYPES if calibration is None else [calibration]

    for mjd in mjds:
       for calibration in calibrations:
            create_imagetyp_hdrfix(mjd=mjd, calibration=calibration)


@click.command('qaqual-bad-hdrfix', short_help='HdrFix for QAQUAL header keyword in dome/twilight flats and arcs calibration')
@click.option('-m', '--mjd', type=int, help='an MJD to analyze')
@click.option('-l', '--mjd-list', type=IntListType(), help='a list of specific MJDs to analyze')
@click.option('-r', '--mjd-range', type=str, help='a range of MJDs to analyze')
@click.option('-e', '--expnum', type=int, help='a exposure number to analyze')
@click.option('-el', '--expnum-list', type=IntListType(), help='a list of specific exposure numbers to analyze')
@click.option('-er', '--expnum-range', type=IntRangeType(), help='a range of exposure numbers to analyze')
@cloup.constraint(mutually_exclusive, ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(mutually_exclusive, ['expnum', 'expnum_list', 'expnum_range'])
@cloup.constraint(RequireExactly(1), ['mjd', 'mjd_list', 'mjd_range'])
@cloup.constraint(RequireExactly(1), ['expnum', 'expnum_list', 'expnum_range'])
def qaqual_bad_hdrfix(mjd, mjd_list, mjd_range, expnum, expnum_list, expnum_range):
    mjds = parse_mjds(mjd=mjd or mjd_list or mjd_range or None)
    if not isinstance(mjds, (list, tuple)):
        mjds = [mjds]

    expnums = expnum or expnum_list or expnum_range or None
    if not isinstance(expnums, (list, tuple)):
        expnums = [expnums]

    for mjd in mjds:
        create_qaqual_bad_hdrfix(mjd=mjd, expnums=expnums)


@cli.command('cluster', short_help='Submit a Utah cluster run', context_settings=dict(show_default=True))
@click.option('-l', '--mjd-list', type=int, default=None, multiple=True, help='a list of specific MJDs to reduce')
@click.option('-r', '--mjd-range', type=str, default=None, help='a range of MJDs to reduce')
@click.option('--from-epochs', is_flag=True, default=False, help="Use fiducial or given epochs file to produce long-term calibrations")
@click.option('--epochs-file', type=str, default=None, help="Path to a calibrations epoch file")
@click.option('--routine', type=click.Choice(CALIBRATION_SCRIPTS), default="long-term", help="run detrend, long-term, nightly, ffactors-experiment, fiberflats or fiberflat-corrections calibrations only")
@click.option('-n', '--nodes', type=int, default=2, help='the number of nodes to use')
@click.option('-p', '--ppn', type=int, default=64, help='the number of CPU cores to use per node')
@click.option('-w', '--walltime', type=str, default="24:00:00", help='the time for which the job is allowed to run')
@click.option('-a', '--alloc', type=click.Choice(['sdss-np', 'sdss-kp']), default='sdss-np', help='which partition to use')
@click.option('-s', '--submit', is_flag=True, type=bool, default=True, help='flag to submit the job or not')
@click.option('-v', '--verbose', is_flag=True, type=bool, default=False, help='flag to display full epochs file at the start of the run')
@click.option('--drp-options', type=str, default="", help="pass options to drp run command")
@click.option("--dry-run", is_flag=True, default=False, help="Logs useful information abaut the current setup without actually reducing, by default False")
def cluster_calibs(mjd_list, mjd_range, from_epochs, epochs_file, routine, nodes, ppn, walltime, alloc, submit, verbose, drp_options, dry_run):

    mjds = parse_mjds(mjd=mjd_list or mjd_range or None)
    # if no MJD, get fiducial calibration epochs
    if from_epochs or mjds is None:
        epochs = load_epochs_file(
            epochs_kind="ffactor" if routine == "fiberflat-corrections" else "calibration",
            epochs_path=epochs_file,
            filter_by_mjds=mjds,
            verbose=verbose)
        mjds = sorted(list(epochs.keys()))

    run_cluster_cals(mjds, from_epochs=from_epochs, nodes=nodes, ppn=ppn, walltime=walltime, alloc=alloc, submit=submit,
                     routine=routine, drp_options=drp_options, dry_run=dry_run)


