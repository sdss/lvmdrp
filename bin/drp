@click.option("--dry-run", is_flag=True, default=False, help="Show the products found and output paths without measuring anything")
def qa_wavelengths_cli(mjd_epoch, kind, cameras, epochs_file, output_dir, with_sum, fibers, extract, nprocs, remeasure, dry_run):
